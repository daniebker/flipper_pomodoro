# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="pomodoro_app",  # Must be unique
    name="Pomodoro",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pomodoro_app_app",
    stack_size=2 * 1024,
    fap_category="Tools",
    # Optional values
    fap_version="1.3",
    fap_icon="pomodoro_app.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/pomodoro_app",
    fap_icon_assets="images",  # Image assets to compile for this application
)
